# Server-only. Copy to .env, never commit the real file.
HOST=127.0.0.1
PORT=4280
DATABASE_PATH=./data/echo.db
ALLOW_REGISTRATION=false
CORS_ORIGINS=http://localhost:8081,http://localhost:4173
# AI_PROVIDER: compatible | ollama
AI_PROVIDER=ollama
AI_ENDPOINT=http://localhost:11434
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_API_KEY=
# Build-time, public, non-secret metadata only
EXPO_PUBLIC_BUILD_COMMIT=development
