{
  "expo": {
    "name": "Echo",
    "slug": "echo-openrecode",
    "version": "0.1.0",
    "scheme": "echo",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./public/icons/icon-1024.png",
    "ios": {
      "bundleIdentifier": "it.openrecode.echo",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.openrecode.echo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/adaptive-foreground.png",
        "backgroundColor": "#6269f5",
        "monochromeImage": "./public/icons/monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
