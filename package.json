{
  "name": "echo-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start -w @echo/client",
    "web": "npm run web -w @echo/client",
    "ios": "npm run ios -w @echo/client",
    "android": "npm run android -w @echo/client",
    "api": "npm run dev -w @echo/api",
    "test": "tsx --test packages/core/test/*.test.ts apps/api/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run build -w @echo/client",
    "db:migrate": "npm run migrate -w @echo/api",
    "preview": "node scripts/serve-web.mjs",
    "test:e2e": "playwright test",
    "assets:generate": "node scripts/branding.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
